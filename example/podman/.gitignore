# Minted per topology by its own mint.sh, never committed: these are a laboratory's private
# keys. A topology whose certificate manager makes its own authority has none of these.
topologies/*/certs/
topologies/*/ocsp/
topologies/*/issuer_ids.env

# The same issuer ids again, under the name compose reads them by. Two copies because two
# things read them: compose wants one beside the compose file it is given, and helpers.sh
# wants one beside itself.
.env
topologies/*/.env

# The old shared locations, from when one laboratory was the only one. Nothing writes or
# reads these any more; a tree that still has them can delete them.
certs/
issuer_ids.env
ocsp/

# Written by reset.sh: which of the four laboratories is up. helpers.sh reads it so that
# run_in can tell "this laboratory has no gateway" from "the gateway is not running".
.topology
