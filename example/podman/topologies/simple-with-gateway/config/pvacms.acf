# Who may decide a certificate request, on the one PVACMS this laboratory has.
#
# One authority, so one AUTHORITY entry: every certificate here traces to the same root,
# and a rule tells holders apart by their user access group alone.

AUTHORITY(CMS_AUTH, "EPICS Root Certificate Authority")

UAG(CMS_ADMIN) {admin, certadmin}

ASG(DEFAULT) {
    RULE(0,READ)
    RULE(1,WRITE) {
        UAG(CMS_ADMIN)
        AUTHORITY(CMS_AUTH)
        PROTOCOL(TLS)
        METHOD("x509")
    }
}
