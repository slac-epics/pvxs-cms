# The four laboratories this example can bring up, and what each one is made of.
#
# One place to say it, read by reset.sh to decide what to start and by helpers.sh to decide
# which places run_in will accept. A topology is a directory beside this file: the directory
# name is the name you pass to ./reset.sh, and its compose.yaml is what gets started.
#
# TOPOLOGY_PLACES is what "run_in <place>" understands while that laboratory is up. Naming a
# place the running topology has no container for is answered with that list rather than a
# lookup failure, which is the difference between "there is no gateway in this laboratory"
# and "something is broken".

TOPOLOGY_NAMES="simple simple-with-gateway federated-shared-root federated-non-shared-root"

# ---------------------------------------------------------------- simple
# One segment, one self-signed root held by PVACMS, which issues every certificate directly.
# Two IOCs and a workstation. Nothing crosses a boundary because there is no boundary.
TOPOLOGY_simple_TITLE="one segment, one self-signed authority, no boundary to cross"
TOPOLOGY_simple_PLACES="lab lab-pvacms testioc tstioc"

# ---------------------------------------------------------------- simple-with-gateway
# The simple laboratory, published at a facility address. A gateway stands in the DMZ and
# proxies inward; a load balancer owns the facility address and maps a port to the gateway.
# Nothing inside originates traffic outward, so there is no router.
TOPOLOGY_simple_with_gateway_TITLE="one laboratory, reached from outside through a gateway"
TOPOLOGY_simple_with_gateway_PLACES="lab lab-pvacms testioc tstioc gateway internet"

# ---------------------------------------------------------------- federated-shared-root
# Two departments, each with its own PVACMS and gateway, both chaining to one facility
# root whose status is answered by a responder. Certificates from either
# department are trusted everywhere, because everything chains to that one root.
TOPOLOGY_federated_shared_root_TITLE="two departments under one facility root"
TOPOLOGY_federated_shared_root_PLACES="lab ml internet lab-pvacms ml-pvacms testioc tstioc ml-ioc gateway ml-gateway"

# ---------------------------------------------------------------- federated-non-shared-root
# Two departments under two independent roots that rotate separately. Trust cannot come from
# a shared chain, so each keychain stores both roots as trust anchors: one identity, many
# anchors, and a status reply signed under either root verifies.
TOPOLOGY_federated_non_shared_root_TITLE="two departments under two independent roots"
TOPOLOGY_federated_non_shared_root_PLACES="lab ml internet lab-pvacms ml-pvacms testioc tstioc ml-ioc gateway ml-gateway"
