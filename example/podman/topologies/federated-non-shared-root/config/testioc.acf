# Lab (control systems department) IOC access control.
#
# Nothing stands above the two departments' roots, so a rule that names an authority is
# naming a department outright. Both roots are declared here, and the lab's own intermediate
# is declared inside the root that signs it:
#
#   LAB_CA    the lab root, and so anything issued anywhere beneath it
#   AUTH_LAB  the lab intermediate, which is what the lab PVACMS signs with
#   ML_CA     the ML root, which that department signs every certificate with
#
# Policy:
#   READ            open to everyone, with or without a certificate, from either department.
#   WRITE (default) guests and operators under the lab's own intermediate; under the ML root,
#                   operators alone.
#   test:spec       operators of either department may write; guests may only read it.
#   test:labspec    trust and authorisation asked separately: either department's certificate
#                   is trusted, and only one carrying the lab's own unit may write.
#   test:open       any certificate holder from either department.

AUTHORITY(LAB_CA, "EPICS Lab Root Certificate Authority") {
    AUTHORITY(AUTH_LAB, "EPICS Controls Intermediate CA")
}
AUTHORITY(ML_CA, "EPICS ML Root Certificate Authority")

UAG(OPERATORS) {
    "gateway",
    "operator"
}

UAG(GUESTS) {
    "guest"
}

# The two gateways, by the common name each presents when it forwards a request upstream.
UAG(GATEWAYS) {
    "gateway",
    "ml-gateway"
}

# Anyone at or below the beamline, named by what their certificate says rather than by who
# they are. An entry that names subject fields places a condition only on the fields it names,
# so this one says nothing about the common name or the organization.
#
# The organizational units a subject carries are read innermost first, so they are a
# containment path: a certificate for OU=staff,OU=beamline says staff sits inside beamline.
# This entry names one unit, so it admits any certificate carrying beamline among its units,
# wherever in the path it sits.
#
# Try it: authnstd -u client -n visitor --ou staff --ou beamline
UAG(BEAMLINE) {
    "OU=beamline"
}

# Anyone whose certificate places them in the lab's own unit.
UAG(LAB_UNIT) {
    "OU=lab"
}

# The test:spec special variable: operators of either department may write; guests cannot.
ASG(SPECIAL) {
    RULE(1,READ)
    RULE(1,WRITE,TRAPWRITE) {
        UAG(OPERATORS)
        AUTHORITY(AUTH_LAB, ML_CA)
        PROTOCOL(TLS)
        METHOD(X509)
    }
}

# The test:labspec special variable: trust and authorisation asked separately.
#
# The rule names both roots, so a certificate from either department is equally trusted here.
# What it then asks is what the certificate says about its holder: only one carrying the lab's
# own unit may write. An operator from the ML department is refused on the unit, not on the
# authority.
#
# Note what that does and does not guarantee. The unit is a claim the issuing department
# vouched for, so a rule which must not be crossed under any circumstances should name the one
# authority it will accept; naming both trusts both departments to issue that unit honestly.
ASG(LABSPEC) {
    RULE(1,READ)
    RULE(1,WRITE,TRAPWRITE) {
        UAG(LAB_UNIT)
        AUTHORITY(LAB_CA, ML_CA)
        PROTOCOL(TLS)
        METHOD(X509)
    }
}

# A variable any certificate holder may write, from either department.
#
# Two ways in, and they are checked differently. A client in this department connects to the
# IOC itself, so the rule sees that client: it names no user, only that a certificate was
# presented over TLS under one of the two roots, so anyone holding one qualifies.
#
# A client in the other department reaches this variable through a gateway, and a gateway
# makes its upstream connection as itself. What this rule then sees is the gateway, not the
# client behind it, which is why the gateway is named. Who the client was is decided at the
# gateway, by the matching rule in its own access file.
ASG(OPEN) {
    RULE(1,READ)
    # Anyone in either department holding a certificate.
    RULE(1,WRITE,TRAPWRITE) {
        AUTHORITY(LAB_CA, ML_CA)
        PROTOCOL(TLS)
        METHOD(X509)
    }
    # Forwarded from the other department, arriving as the gateway.
    RULE(1,WRITE,TRAPWRITE) {
        UAG(GATEWAYS)
        AUTHORITY(LAB_CA, ML_CA)
        PROTOCOL(TLS)
        METHOD(X509)
    }
}

# Ordinary lab variables.
ASG(DEFAULT) {
    # READ open to anyone, with or without a certificate, from either department.
    RULE(1,READ)
    # WRITE under this department's own intermediate: guests and operators alike.
    RULE(1,WRITE,TRAPWRITE) {
        UAG(OPERATORS,GUESTS)
        AUTHORITY(AUTH_LAB)
        PROTOCOL(TLS)
        METHOD(X509)
    }
    # WRITE under the ML root: operators only.
    RULE(1,WRITE,TRAPWRITE) {
        UAG(OPERATORS)
        AUTHORITY(ML_CA)
        PROTOCOL(TLS)
        METHOD(X509)
    }
    # WRITE for anyone the beamline encloses, whoever they are. Nobody has to be named
    # individually: a person joining the beamline gets a certificate saying so and can write.
    RULE(1,WRITE,TRAPWRITE) {
        UAG(BEAMLINE)
        AUTHORITY(AUTH_LAB)
        PROTOCOL(TLS)
        METHOD(X509)
    }
}
