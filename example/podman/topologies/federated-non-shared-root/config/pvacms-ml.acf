# Who may administer the machine learning department's certificate manager.
#
# This department holds its own root and signs every certificate with it, so there is no
# intermediate to name: the authority an administrator's certificate must come from is the
# root itself. That is the whole difference from the lab department's file beside this one,
# and neither root constrains the other, so the two are free to differ like this.

AUTHORITY(CMS_AUTH, "EPICS ML Root Certificate Authority")

UAG(CMS_ADMIN) {admin, mlcertadmin}

ASG(DEFAULT) {
    RULE(0,READ)
    RULE(1,WRITE) {
        UAG(CMS_ADMIN)
        AUTHORITY(CMS_AUTH)
        PROTOCOL(TLS)
        METHOD("x509")
    }
}
