# Default placeholder pvlist baked into the gateway image. The real per-gateway
# pvlist (internet.pvlist / ml.pvlist, with the department issuer id substituted)
# is supplied at deploy time by the helm ConfigMap and overwrites gateway.conf, so
# this file is NOT used by the deployed lab. Kept minimal to avoid confusion.
test:.* ALLOW
CERT:CREATE(?::.*)? ALLOW CERT_CREATE
CERT:STATUS(?::.*)? ALLOW CERT_STATUS
