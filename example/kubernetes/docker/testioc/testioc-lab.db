# One process variable for the laboratory, beside the ones the pvxs test databases provide.
#
# test:spec shows what the shared facility root buys: an operator holding a certificate from
# either department may write it, because the rule authorises on the root both departments
# chain to.
#
# This one shows the other half. Its rule authorises on the same shared root, so a
# certificate from either department is equally trusted, and then asks what the certificate
# says about its holder: only one carrying the lab's organizational unit may write. Trust and
# authorisation are separate questions, and this is where they part company.
record(ao, "test:labspec") {
   field(ASG, "LABSPEC")
   field(DESC, "Writable only by the lab's own unit")
}

# A variable any certificate holder may write, from either zone. Its access group asks for a
# certificate and nothing else: no user is named, so anyone the facility root vouches for
# qualifies. test:spec by contrast names operators, and test:labspec names a unit.
record(ao, "test:open") {
   field(ASG, "OPEN")
   field(DESC, "Any certificate holder, either zone")
}

# A variable no anonymous client can see at all. Its access group carries no unqualified rule,
# so a caller with no certificate is refused both ways. A holder of any certificate this
# laboratory trusts may read it, and only the lab department may write it.
record(ao, "test:hidden") {
   field(ASG, "HIDDEN")
   field(DESC, "Cert holders read, lab dept writes")
}
