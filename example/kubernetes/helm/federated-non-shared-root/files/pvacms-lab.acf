# Who may administer the lab department's PVACMS.
#
# The lab root signs an intermediate, and PVACMS signs with the intermediate, so the
# authority an administrator's certificate must come from is named inside the root that
# vouches for it.

AUTHORITY("EPICS Lab Root Certificate Authority") {
    AUTHORITY(CMS_AUTH, "EPICS Controls Intermediate CA")
}

UAG(CMS_ADMIN) {admin, certadmin}

ASG(DEFAULT) {
    RULE(0,READ)
    RULE(1,WRITE) {
        UAG(CMS_ADMIN)
        AUTHORITY(CMS_AUTH)
        PROTOCOL(TLS)
        METHOD("x509")
    }
}
